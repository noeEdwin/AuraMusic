  url: {{baseUrl}}/api/setlists/{{setlistId}}/items/{{itemId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{musicianToken}}
  Content-Type: application/json
}

body:json {
  {
    "transposeSteps": 2,
