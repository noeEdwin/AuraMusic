meta {
  name: Update own artist
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/artists/{{artistId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{musicianToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno Musician Artist Updated",
    "bio": "Artista propio actualizado",
    "imageUrl": "https://images.auramusic.local/artists/bruno.png"
  }
}
